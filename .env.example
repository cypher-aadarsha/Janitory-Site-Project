# Django Settings
SECRET_KEY=generate_a_secure_random_key_here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,123.456.78.9

# Database Settings (Only if using PostgreSQL later, SQLite ignores this)
# DATABASE_URL=postgres://user:password@localhost:5432/janitory_db


# ─── Google Tracking ─────────────────────────────────────────────────────
# These already default to the live IDs in settings.py. Override here only
# if the IDs change, or set them BLANK on a staging server so test traffic
# never pollutes the production Analytics/Ads data.
GOOGLE_ANALYTICS_ID=G-JLBYG49T3E
GOOGLE_ADS_CONVERSION_ID=AW-1962616492
GOOGLE_TAG_MANAGER_ID=GTM-K3K8Z87F

# Conversion action LABELS.
#
# The conversion ID above only identifies the ACCOUNT. Each conversion
# action also has its own LABEL, and without it Google Ads records zero
# conversions no matter how much you spend.
#
# The lead label below is already set as the default in settings.py, so it
# works without being listed here. It belongs to the "Contact Form Submit"
# conversion action (Source: Website, Event: Manual event).
#
# To find a label for a new action:
#   Google Ads > Goals > Conversions > click the action
#   > Manage > "Set up with a Google tag" > See event snippet
#   > copy the part AFTER the slash in send_to: 'AW-18322970920/XXXXXXXX'
GOOGLE_ADS_LEAD_CONVERSION_LABEL=<REAL_LABEL_HERE>

# Leave BLANK if you track calls with Google forwarding numbers ("Calls from
# website visits"). Google counts the real call itself, so firing our own
# tel:-click conversion as well would double-count every call. Blank means
# the site still records a GA4 contact_click event for analysis, but sends
# no conversion to Ads.
GOOGLE_ADS_CALL_CONVERSION_LABEL=


# ─── Lead Notification Email ─────────────────────────────────────────────
# Without these, form submissions are saved to the database but NOBODY is
# emailed — leads sit unseen in the CMS.
#
# NOTE: DigitalOcean blocks outbound SMTP (ports 25/465/587/2525) on this
# droplet, so the SMTP settings below cannot connect from production. Mail
# relays over HTTPS instead — see the Brevo section further down.
#
# If DigitalOcean ever lifts the block, delete the EMAIL_BACKEND line in the
# Brevo section and these settings take over again with no code change.
#
# For Gmail, EMAIL_HOST_PASSWORD must be a 16-character App Password from
# https://myaccount.google.com/apppasswords — a normal account password is
# rejected by Google's SMTP server.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=youraddress@gmail.com

# Who receives new lead alerts (comma-separated).
# Leave blank to fall back to the contact email set in the CMS.
LEAD_NOTIFICATION_EMAILS=24hrfacilitymaintenance@gmail.com


# ─── Brevo (HTTPS email relay) ───────────────────────────────────────────
# Used because outbound SMTP is blocked by the host. Brevo's API runs on
# port 443, which is not blocked.
#
# Setup:
#   1. Sign up at https://www.brevo.com (free tier: 300 emails/day)
#   2. Senders, Domains & Dedicated IPs > Senders > Add a sender
#      Verify the address you want mail to come FROM, and set
#      DEFAULT_FROM_EMAIL above to match it exactly — Brevo rejects mail
#      from an unverified sender.
#   3. SMTP & API > API Keys > Generate a new API key, paste it below.
#
# Comment out EMAIL_BACKEND to fall back to plain SMTP.
EMAIL_BACKEND=core.email_backends.BrevoAPIBackend
BREVO_API_KEY=xkeysib-your-api-key-here
